# /etc/caddy-cert-sync/config.conf — KHÔNG chứa bí mật (bí mật nằm ở telegram.conf và sbc.cred, quyền 600)
# Mỗi server có một bản riêng; bản mẫu theo từng server nằm trong profiles/<tên>/config.conf của repo.

# ---- Cert nguồn ----
DOMAIN="sip.example.com"                 # TODO: domain của server này
CADDY_CERT_BASE="/var/lib/caddy/.local/share/caddy"   # thư mục chứa certificates/ (Caddy hoặc lego, mục 5.11)

# ---- PBX: chép file rồi restart đúng 1 container ----
PBX_CRT="/var/lib/portsip/pbx/certificates/portsip.crt"
PBX_KEY="/var/lib/portsip/pbx/certificates/portsip.key"
PORTSIP_UID=888
PORTSIP_GID=888
PBX_RESTART_CONTAINERS="portsip.webserver"
PBX_PORTS="8887"                         # cổng dùng để ĐO cert PBX đang phục vụ

# ---- SBC: thay cert qua API, không chép file ----
SBC_API_BASE="https://127.0.0.1:8883/sbc/api"
SBC_TOKEN_JQ='.["access-token"]'
SBC_TLS_DOMAIN="$DOMAIN"
SBC_WEB_DOMAIN=true
SBC_DELETE_FIRST=true
SBC_FALLBACK_RESTART="nginx"
SBC_PORTS="8883 10443 5065 5067"

# ---- Khung giờ được phép restart/thay cert (giờ máy chủ) ----
WINDOW_START=22
WINDOW_END=5

# ---- Trạng thái và nhật ký ----
STATE_DIR="/var/lib/caddy-cert-sync"
LOG="/var/log/caddy-cert-sync.log"

# ---- Tuỳ chọn (bỏ dấu # để bật) ----
#DEPLOY_WHEN_DAYS_LEFT=20               # chỉ thay vào PortSIP khi cert đang dùng còn <= ngần này ngày
#MAX_AUTO_ATTEMPTS=2
#STUCK_HOURS=20
#STAGE_ALERT_SECS=1800
#CERT_SOURCE_NAME="lego"                # chữ hiện trong tin Telegram (mặc định Caddy)
#USE_CADDY=false                        # health-check bỏ qua dịch vụ caddy
#RENEW_TIMER_UNIT="lego-renew.timer"    # health-check kiểm tra timer xin cert
#RENEW_DAYS_BEFORE_EXPIRY=45            # chỉ dùng với set-renew-days.sh (phải lớn hơn khoảng 30 mới có tác dụng)
#CERT_LIFETIME_DAYS=90

# ---- Tuỳ chọn khác ----
#PBX_SNI="pbx.example.com"              # SNI dùng khi đo cổng PBX (mặc định DOMAIN)
#SBC_SNI="sbc.example.com"              # SNI dùng khi đo cổng SBC (mặc định SBC_TLS_DOMAIN)
#SBC_DOCKER_CMD=none                    # SBC ở VM khác: none = không docker exec; hoặc "ssh user@vm-sbc docker"
#EXPIRY_ALERT_DAYS="30 14 7 3 1"        # các mốc (ngày) cảnh báo cert đang dùng sắp hết hạn

# ---- PBX ở VM khác (xem profiles/diff-vm) ----
#PBX_SSH="root@10.0.0.1"                # đặt thì PBX được thay qua SSH tới pbx-agent.sh; để trống = PBX ở máy này
#PBX_SSH_KEY="/etc/caddy-cert-sync/pbx_ssh_key"
#                                        # TODO QUAN TRỌNG: nếu bỏ dấu # ở PBX_SSH (PBX ở VM khác),
#                                        # cũng phải sửa PBX_PORTS phía trên thành "IP-VM-PBX:8887"
#                                        # (ví dụ PBX_PORTS="10.0.0.1:8887"), nếu không hệ thống sẽ
#                                        # đo cổng 8887 trên CHÍNH MÁY NÀY thay vì trên VM PBX.
